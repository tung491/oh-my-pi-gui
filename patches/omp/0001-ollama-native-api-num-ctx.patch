--- /dev/null
+++ b/packages/ai/test/ollama-num-ctx.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from "bun:test";
+import type { Context } from "@oh-my-pi/pi-ai";
+import { streamOllama } from "@oh-my-pi/pi-ai/providers/ollama";
+import { buildModel } from "@oh-my-pi/pi-catalog/build";
+
+function ollamaModel(provider: "ollama" | "ollama-cloud") {
+	return buildModel({
+		id: "gemma4:e2b",
+		name: "Gemma 4 E2B",
+		api: "ollama-chat",
+		provider,
+		baseUrl: provider === "ollama" ? "http://127.0.0.1:11434" : "https://ollama.com",
+		reasoning: false,
+		input: ["text"],
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+		contextWindow: 16_384,
+		maxTokens: 8192,
+	});
+}
+
+async function requestOptions(provider: "ollama" | "ollama-cloud"): Promise<Record<string, unknown> | undefined> {
+	let options: Record<string, unknown> | undefined;
+	const fetchMock = async (_input: string | URL | Request, init?: RequestInit): Promise<Response> => {
+		const body = JSON.parse(String(init?.body)) as { options?: Record<string, unknown> };
+		options = body.options;
+		return new Response('{"message":{"content":"ok"},"done":true,"prompt_eval_count":1,"eval_count":1}\n', {
+			status: 200,
+		});
+	};
+	const context: Context = { messages: [{ role: "user", content: "hi", timestamp: 0 }] };
+	await streamOllama(ollamaModel(provider), context, { apiKey: "test-key", fetch: fetchMock }).result();
+	return options;
+}
+
+describe("Ollama chat context size", () => {
+	it("asks a local server for the model's context window", async () => {
+		expect((await requestOptions("ollama"))?.num_ctx).toBe(16_384);
+	});
+
+	it("leaves the context to Ollama Cloud", async () => {
+		expect((await requestOptions("ollama-cloud"))?.num_ctx).toBeUndefined();
+	});
+});
