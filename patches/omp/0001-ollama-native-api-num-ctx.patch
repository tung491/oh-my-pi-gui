+/**
+ * Context the implicit Ollama provider requests per call over the native API
+ * when `OLLAMA_CONTEXT_LENGTH` is unset. Ollama's own default (4096 on most
+ * GPUs) is smaller than the agent's first request.
+ */
+export const OLLAMA_NATIVE_DEFAULT_CONTEXT = 16_384;
+
+/**
+ * The api the implicit Ollama provider speaks. `PI_OLLAMA_API=ollama-chat`
+ * selects the native `/api/chat`, which can carry `num_ctx`; the OpenAI-compatible
+ * endpoint stays the default.
+ */
+export function getImplicitOllamaApi(): "openai-responses" | "ollama-chat" {
+	return Bun.env.PI_OLLAMA_API?.trim() === "ollama-chat" ? "ollama-chat" : "openai-responses";
+}
