+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { Agent } from "@oh-my-pi/pi-agent-core";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import type { FetchImpl } from "@oh-my-pi/pi-ai/types";
+import { getBundledModels } from "@oh-my-pi/pi-catalog/models";
+import { isLoopbackBaseUrl, isOllamaCloudTag, ModelPolicyError } from "@oh-my-pi/pi-coding-agent/config/model-policy";
+import { kNoAuth, ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { removeSyncWithRetries, Snowflake } from "@oh-my-pi/pi-utils";
+
+const LOCAL_ONLY = {
+	"modelPolicy.providers": ["ollama"],
+	"modelPolicy.localOnly": true,
+};
+
+/** `/api/tags` as a signed-in Ollama daemon reports it: two cloud tags and a renamed remote copy. */
+const OLLAMA_TAGS = {
+	models: [
+		{ name: "gemma4:e4b", model: "gemma4:e4b" },
+		{
+			name: "kimi-k2:cloud",
+			model: "kimi-k2:cloud",
+			remote_model: "kimi-k2",
+			remote_host: "https://ollama.com:443",
+		},
+		{ name: "gpt-oss:120b-cloud", model: "gpt-oss:120b-cloud" },
+		{
+			name: "mine:latest",
+			model: "mine:latest",
+			remote_model: "gpt-oss:120b",
+			remote_host: "https://ollama.com:443",
+		},
+	],
+};
+
+const ollamaFetch: FetchImpl = input => {
+	const url = String(input);
+	if (url.endsWith(":11434/api/tags")) return Promise.resolve(Response.json(OLLAMA_TAGS));
+	if (url.endsWith(":11434/api/show")) return Promise.resolve(Response.json({}));
+	return Promise.resolve(new Response(null, { status: 404 }));
+};
+
+describe("modelPolicy", () => {
+	let tempDir: string;
+	let modelsJsonPath: string;
+	let authStorage: AuthStorage;
+	let originalOllamaBaseUrl: string | undefined;
+	let originalOllamaHost: string | undefined;
+
+	beforeEach(async () => {
+		originalOllamaBaseUrl = Bun.env.OLLAMA_BASE_URL;
+		originalOllamaHost = Bun.env.OLLAMA_HOST;
+		delete Bun.env.OLLAMA_BASE_URL;
+		delete Bun.env.OLLAMA_HOST;
+		tempDir = path.join(os.tmpdir(), `pi-test-model-policy-${Snowflake.next()}`);
+		fs.mkdirSync(tempDir, { recursive: true });
+		modelsJsonPath = path.join(tempDir, "models.json");
+		authStorage = await AuthStorage.create(path.join(tempDir, "auth.db"));
+		await authStorage.credentials.set("anthropic", [{ type: "api_key", key: "sk-ant-test" }]);
+	});
+
+	afterEach(() => {
+		authStorage.close();
+		if (originalOllamaBaseUrl === undefined) delete Bun.env.OLLAMA_BASE_URL;
+		else Bun.env.OLLAMA_BASE_URL = originalOllamaBaseUrl;
+		if (originalOllamaHost === undefined) delete Bun.env.OLLAMA_HOST;
+		else Bun.env.OLLAMA_HOST = originalOllamaHost;
+		removeSyncWithRetries(tempDir);
+	});
+
+	function registry(overrides: Record<string, unknown>): ModelRegistry {
+		return new ModelRegistry(authStorage, modelsJsonPath, {
+			fetch: ollamaFetch,
+			settings: Settings.isolated(overrides),
+		});
+	}
+
+	function anthropicModel() {
+		const model = getBundledModels("anthropic")[0];
+		if (!model) throw new Error("the bundled catalog has no anthropic model");
+		return model;
+	}
+
+	test("recognises Ollama cloud tags in any part of the id", () => {
+		for (const id of [
+			"kimi-k2:cloud",
+			"gpt-oss:120b-cloud",
+			"x-cloud",
+			"kimi-k2:cloud:low",
+			"qwen3-coder:480b-cloud",
+		]) {
+			expect(isOllamaCloudTag(id)).toBe(true);
+		}
+		for (const id of ["gemma4:e4b", "llama3:8b", "hf.co/google/gemma-4-E4B-it-qat-q4_0-gguf", "cloudy:7b"]) {
+			expect(isOllamaCloudTag(id)).toBe(false);
+		}
+	});
+
+	test("treats only this computer's addresses as local", () => {
+		for (const url of [
+			"http://127.0.0.1:11434",
+			"http://localhost:11434/v1",
+			"http://[::1]:11434",
+			"http://127.0.1.1",
+		]) {
+			expect(isLoopbackBaseUrl(url)).toBe(true);
+		}
+		for (const url of [undefined, "", "https://ollama.com", "http://192.168.1.5:11434", "not a url"]) {
+			expect(isLoopbackBaseUrl(url)).toBe(false);
+		}
+	});
+
+	test("an unset policy leaves every provider and model in place", async () => {
+		const open = registry({});
+		await open.refresh("online");
+		const model = anthropicModel();
+		expect(open.find("anthropic", model.id)?.id).toBe(model.id);
+		expect(open.hasConfiguredAuth(model)).toBe(true);
+		expect(
+			open
+				.getAll()
+				.filter(entry => entry.provider === "ollama")
+				.map(entry => entry.id)
+				.sort(),
+		).toEqual(["gemma4:e4b", "gpt-oss:120b-cloud", "kimi-k2:cloud", "mine:latest"]);
+	});
+
+	test("a provider outside the policy neither resolves, gets a key, nor counts as configured", async () => {
+		const local = registry(LOCAL_ONLY);
+		const model = anthropicModel();
+		expect(local.getAll().some(entry => entry.provider === "anthropic")).toBe(false);
+		expect(local.getAvailable().some(entry => entry.provider === "anthropic")).toBe(false);
+		expect(local.find("anthropic", model.id)).toBeUndefined();
+		expect(local.isModelAllowed(model)).toBe(false);
+		expect(local.hasConfiguredAuth(model)).toBe(false);
+		expect(await local.getApiKey(model)).toBeUndefined();
+		expect(await local.getApiKeyForProvider("anthropic")).toBeUndefined();
+		await expect(
+			Promise.resolve(local.resolver(model)({ lastChance: false, error: undefined })),
