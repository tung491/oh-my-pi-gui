diff --git a/packages/coding-agent/src/config/model-policy.ts b/packages/coding-agent/src/config/model-policy.ts
new file mode 100644
index 0000000000..88ae0e44a7
--- /dev/null
+++ b/packages/coding-agent/src/config/model-policy.ts
@@ -0,0 +1,90 @@
+/**
+ * `modelPolicy`: which models a session may resolve, switch to and send
+ * requests to. `modelPolicy.providers` lists the only providers allowed (empty:
+ * every provider). `modelPolicy.localOnly` admits only models served from this
+ * computer: a loopback endpoint, and no Ollama cloud model, which a local
+ * daemon forwards to ollama.com.
+ *
+ * The registry applies the policy to its catalog, its credential lookups and
+ * its request resolvers, so a blocked model can be neither selected nor sent a
+ * request, however it was obtained.
+ */
+import type { Api, Model } from "@oh-my-pi/pi-ai/types";
+import { cfgModelPolicyLocalOnly, cfgModelPolicyProviders } from "./model-settings";
+import { settings as globalSettings, type Settings } from "./settings";
+
+export type ModelPolicySubject = Pick<Model<Api>, "provider" | "id"> & {
+	baseUrl?: string;
+};
+
+export interface ModelPolicy {
+	/** Lower-cased allowed provider ids; null when every provider is allowed. */
+	readonly providers: ReadonlySet<string> | null;
+	readonly localOnly: boolean;
+}
+
+const UNRESTRICTED: ModelPolicy = { providers: null, localOnly: false };
+
+/** Thrown when a blocked model is selected or a request to it is resolved. */
+export class ModelPolicyError extends Error {
+	constructor(provider: string, modelId?: string) {
+		super(
+			`${modelId === undefined ? `Provider "${provider}"` : `Model ${provider}/${modelId}`} is not allowed by modelPolicy`,
+		);
+		this.name = "ModelPolicyError";
+	}
+}
+
+/** The policy in effect; unrestricted when no settings are available (early boot, SDK embedding). */
+export function readModelPolicy(settingsInstance?: Settings): ModelPolicy {
+	try {
+		const source = settingsInstance ?? globalSettings;
+		const providers = cfgModelPolicyProviders.get(source);
+		const localOnly = cfgModelPolicyLocalOnly.get(source) === true;
+		if (providers.length === 0 && !localOnly) return UNRESTRICTED;
+		return {
+			providers: providers.length === 0 ? null : new Set(providers.map(id => id.trim().toLowerCase())),
+			localOnly,
+		};
+	} catch {
+		return UNRESTRICTED;
+	}
+}
+
+export function isPolicyRestricted(policy: ModelPolicy): boolean {
+	return policy.providers !== null || policy.localOnly;
+}
+
+export function isProviderAllowed(policy: ModelPolicy, provider: string): boolean {
+	return policy.providers === null || policy.providers.has(provider.trim().toLowerCase());
+}
+
+/**
+ * An Ollama cloud tag: any `:`-separated part of the id equal to `cloud` or
+ * ending in `-cloud` (`kimi-k2:cloud`, `gpt-oss:120b-cloud`).
+ */
+export function isOllamaCloudTag(modelId: string): boolean {
+	return modelId
+		.toLowerCase()
+		.split(":")
+		.some(part => part === "cloud" || part.endsWith("-cloud"));
+}
+
+/** Whether a base URL points at this computer (`localhost`, `127.0.0.0/8`, `::1`, `0.0.0.0`). */
+export function isLoopbackBaseUrl(baseUrl: string | undefined): boolean {
+	if (!baseUrl) return false;
+	let hostname: string;
+	try {
+		hostname = new URL(baseUrl).hostname.toLowerCase();
+	} catch {
+		return false;
+	}
+	hostname = hostname.replace(/^\[/, "").replace(/\]$/, "");
+	return hostname === "localhost" || hostname === "0.0.0.0" || hostname === "::1" || hostname.startsWith("127.");
+}
+
+export function isModelAllowed(policy: ModelPolicy, model: ModelPolicySubject): boolean {
+	if (!isProviderAllowed(policy, model.provider)) return false;
+	if (!policy.localOnly) return true;
+	return isLoopbackBaseUrl(model.baseUrl) && !isOllamaCloudTag(model.id);
+}
