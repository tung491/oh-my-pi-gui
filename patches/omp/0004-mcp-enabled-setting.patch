+++ b/packages/coding-agent/test/sdk-mcp-enabled-setting.test.ts
@@ -0,0 +1,120 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { MCPManager } from "@oh-my-pi/pi-coding-agent/mcp/manager";
+import { MCP_DISABLED_MESSAGE } from "@oh-my-pi/pi-coding-agent/mcp/settings";
+import { applyRpcMcpTest } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-mcp-extra";
+import { createAgentSession } from "@oh-my-pi/pi-coding-agent/sdk";
+import type { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import type { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { __resetDirsFromEnvForTests, removeSyncWithRetries, setAgentDir, Snowflake } from "@oh-my-pi/pi-utils";
+import { createInMemoryAuthStorage } from "./helpers/agent-session-setup";
+
+/** How long a session gets to start a configured server before the marker is read. */
+const START_WAIT_MS = 1_500;
+
+function restoreEnv(key: string, value: string | undefined): void {
+	if (value === undefined) delete process.env[key];
+	else process.env[key] = value;
+}
+
+/**
+ * A stdio MCP server in the user's mcp.json and in the project's .mcp.json. It never answers;
+ * it appends its config label to `marker` when it starts.
+ */
+function plantServers(root: string, agentDir: string, cwd: string): string {
+	const marker = path.join(root, "started");
+	const server = path.join(root, "server.sh");
+	fs.writeFileSync(server, `#!/bin/sh\necho "$1" >>${JSON.stringify(marker)}\nexec cat >/dev/null\n`, {
+		mode: 0o755,
+	});
+	const config = (label: string) =>
+		JSON.stringify({ mcpServers: { [`tripwire-${label}`]: { type: "stdio", command: server, args: [label] } } });
+	fs.writeFileSync(path.join(agentDir, "mcp.json"), config("user"));
+	fs.writeFileSync(path.join(cwd, ".mcp.json"), config("project"));
+	return marker;
+}
+
+function starts(marker: string): string[] {
+	if (!fs.existsSync(marker)) return [];
+	return fs.readFileSync(marker, "utf8").split("\n").filter(Boolean).sort();
+}
+
+describe("mcp.enabled", () => {
+	let root: string;
+	let cwd: string;
+	let marker: string;
+	let authStorage: AuthStorage;
+	let session: AgentSession | undefined;
+	const originalAgentDir = process.env.PI_CODING_AGENT_DIR;
+
+	beforeEach(() => {
+		root = path.join(os.tmpdir(), `pi-mcp-enabled-${Snowflake.next()}`);
+		const agentDir = path.join(root, "agent");
+		cwd = path.join(root, "project");
+		fs.mkdirSync(agentDir, { recursive: true });
+		fs.mkdirSync(cwd, { recursive: true });
+		setAgentDir(agentDir);
+		marker = plantServers(root, agentDir, cwd);
+		authStorage = createInMemoryAuthStorage();
+		MCPManager.resetForTests();
+	});
+
+	afterEach(async () => {
+		try {
+			await session?.dispose();
+			session = undefined;
+			await MCPManager.instance()?.disconnectAll();
+			MCPManager.resetForTests();
+			authStorage.close();
+		} finally {
+			restoreEnv("PI_CODING_AGENT_DIR", originalAgentDir);
+			__resetDirsFromEnvForTests();
+			removeSyncWithRetries(root);
+		}
+	});
+
+	async function startSession(overrides: Record<string, unknown>): Promise<AgentSession> {
+		const { session: created } = await createAgentSession({
+			cwd,
+			agentDir: path.join(root, "agent"),
+			modelRegistry: new ModelRegistry(authStorage, path.join(root, "models.yml")),
+			sessionManager: SessionManager.inMemory(cwd),
+			settings: Settings.isolated(overrides),
+			model: getBundledModel("openai", "gpt-4o-mini"),
+			disableExtensionDiscovery: true,
+			promptTemplates: [],
+			slashCommands: [],
+			enableLsp: false,
+			toolNames: ["read"],
+			skipPythonPreflight: true,
+		});
+		session = created;
+		return created;
+	}
+
+	it("starts the user's and the project's servers by default", async () => {
+		await startSession({ "mcp.startupTimeoutMs": 1 });
+		await Bun.sleep(START_WAIT_MS);
+		expect(starts(marker)).toEqual(["project", "user"]);
+	});
+
+	it("starts no server from any config when off, even with project config allowed", async () => {
+		const created = await startSession({ "mcp.enabled": false, "mcp.enableProjectConfig": true });
+		await Bun.sleep(START_WAIT_MS);
+		expect(starts(marker)).toEqual([]);
+		expect(MCPManager.instance()).toBeUndefined();
+
+		const byName = await applyRpcMcpTest(created, "tripwire-user", undefined);
+		expect(byName).toEqual({ ok: false, error: MCP_DISABLED_MESSAGE });
+		const inline = await applyRpcMcpTest(created, undefined, { transport: "stdio", command: "/bin/true" });
+		expect(inline).toEqual({ ok: false, error: MCP_DISABLED_MESSAGE });
+		await Bun.sleep(START_WAIT_MS);
+		expect(starts(marker)).toEqual([]);
+	});
+});
