@@ -0,0 +1,107 @@
+import { describe, expect, it } from "bun:test";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { AuthStorage } from "@oh-my-pi/pi-ai";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+import { parseArgs } from "@oh-my-pi/pi-coding-agent/cli/args";
+import { VALUELESS_FLAGS } from "@oh-my-pi/pi-coding-agent/cli/flag-tables";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { createAgentSession } from "@oh-my-pi/pi-coding-agent/sdk";
+import type { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+const MARKERS = {
+	cwdAgents: "no-context-files-cwd-agents-marker",
+	cwdClaude: "no-context-files-cwd-claude-marker",
+	parentAgents: "no-context-files-parent-agents-marker",
+	parentClaude: "no-context-files-parent-claude-marker",
+	extraClaude: "no-context-files-extra-root-claude-marker",
+} as const;
+
+/**
+ * Plants AGENTS.md and CLAUDE.md in a working folder and in its parent, and a lone CLAUDE.md in an
+ * extra workspace root. At one depth AGENTS.md shadows CLAUDE.md, so the lone file proves CLAUDE.md loads.
+ */
+function plantInstructionFiles(tempDir: TempDir): { cwd: string; extraRoot: string } {
+	const cwd = tempDir.join("project");
+	const extraRoot = tempDir.join("extra-root");
+	fs.mkdirSync(cwd, { recursive: true });
+	fs.mkdirSync(extraRoot, { recursive: true });
+	fs.writeFileSync(path.join(cwd, "AGENTS.md"), MARKERS.cwdAgents);
+	fs.writeFileSync(path.join(cwd, "CLAUDE.md"), MARKERS.cwdClaude);
+	fs.writeFileSync(tempDir.join("AGENTS.md"), MARKERS.parentAgents);
+	fs.writeFileSync(tempDir.join("CLAUDE.md"), MARKERS.parentClaude);
+	fs.writeFileSync(path.join(extraRoot, "CLAUDE.md"), MARKERS.extraClaude);
+	return { cwd, extraRoot };
+}
+
+async function createSession(
+	cwd: string,
+	extraRoot: string,
+	noContextFiles: boolean,
+): Promise<{ session: AgentSession; authStorage: AuthStorage }> {
+	const authStorage = await AuthStorage.create(`${cwd}/auth.db`);
+	const modelRegistry = new ModelRegistry(authStorage, `${cwd}/models.json`);
+	const sessionManager = SessionManager.inMemory(cwd);
+	await sessionManager.setAdditionalDirectories([extraRoot]);
+	const { session } = await createAgentSession({
+		cwd,
+		agentDir: cwd,
+		modelRegistry,
+		sessionManager,
+		settings: Settings.isolated({}),
+		model: getBundledModel("openai", "gpt-4o-mini"),
+		disableExtensionDiscovery: true,
+		promptTemplates: [],
+		slashCommands: [],
+		enableMCP: false,
+		enableLsp: false,
+		toolNames: [],
+		restrictToolNames: true,
+		skipPythonPreflight: true,
+		noContextFiles,
+	});
+	return { session, authStorage };
+}
+
+function markersIn(session: AgentSession): string[] {
+	const prompt = session.systemPrompt.join("\n");
+	return Object.values(MARKERS).filter(marker => prompt.includes(marker));
+}
+
+describe("--no-context-files", () => {
+	it("parses as a value-less flag", () => {
+		const result = parseArgs(["--no-context-files", "explain"]);
+		expect(result.noContextFiles).toBe(true);
+		expect(result.messages).toEqual(["explain"]);
+		expect(VALUELESS_FLAGS.has("--no-context-files")).toBe(true);
+	});
+
+	it("loads the planted instruction files when the flag is absent", async () => {
+		using tempDir = TempDir.createSync("@omp-no-context-files-control-");
+		const { cwd, extraRoot } = plantInstructionFiles(tempDir);
+		const { session, authStorage } = await createSession(cwd, extraRoot, false);
+		try {
+			expect(markersIn(session)).toEqual([MARKERS.cwdAgents, MARKERS.parentAgents, MARKERS.extraClaude]);
+		} finally {
+			await session.dispose();
+			authStorage.close();
+		}
+	});
+
+	it("loads no context file at startup or on a prompt rebuild", async () => {
+		using tempDir = TempDir.createSync("@omp-no-context-files-");
+		const { cwd, extraRoot } = plantInstructionFiles(tempDir);
+		const { session, authStorage } = await createSession(cwd, extraRoot, true);
+		try {
+			expect(markersIn(session)).toEqual([]);
+			await session.refreshSkills();
+			expect(markersIn(session)).toEqual([]);
+		} finally {
+			await session.dispose();
+			authStorage.close();
+		}
+	});
+});
