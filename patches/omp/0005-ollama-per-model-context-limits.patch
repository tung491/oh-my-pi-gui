@@ -0,0 +1,47 @@
+import type { Api, Model } from "@oh-my-pi/pi-ai/types";
+import { isRecord } from "@oh-my-pi/pi-utils";
+import { cfgOllamaContextLimits } from "./model-settings";
+import { type Settings, settings } from "./settings";
+
+/** Largest limit an `ollama.contextLimits` entry may carry (16M tokens, far above any trained context). */
+const MAX_OLLAMA_CONTEXT_LIMIT = 2 ** 24;
+
+/**
+ * The valid `ollama.contextLimits` entries, by exact model id. A malformed entry
+ * (not a positive safe integer, or above 2^24) or a malformed record is dropped,
+ * never an error: a bad limit must not break model discovery.
+ */
+export function readOllamaContextLimits(settingsInstance?: Settings): ReadonlyMap<string, number> {
+	let raw: unknown;
+	try {
+		raw = cfgOllamaContextLimits.get(settingsInstance ?? settings);
+	} catch {
+		return new Map();
+	}
+	const limits = new Map<string, number>();
+	if (!isRecord(raw)) return limits;
+	for (const [id, value] of Object.entries(raw)) {
+		if (typeof value === "number" && Number.isSafeInteger(value) && value > 0 && value <= MAX_OLLAMA_CONTEXT_LIMIT) {
+			limits.set(id, value);
+		}
+	}
+	return limits;
+}
+
+/**
+ * Cap each local Ollama model on the native api at its `ollama.contextLimits`
+ * entry. That api sends the window as `num_ctx`, so the cap is what the server
+ * allocates. A model without an entry keeps its window.
+ */
+export function applyOllamaContextLimits(models: Model<Api>[], limits: ReadonlyMap<string, number>): Model<Api>[] {
+	if (limits.size === 0) return models;
+	return models.map(model => {
+		if (model.provider !== "ollama" || model.api !== "ollama-chat") return model;
+		const limit = limits.get(model.id);
+		if (limit === undefined) return model;
+		const contextWindow = model.contextWindow === null ? limit : Math.min(model.contextWindow, limit);
+		const maxTokens = Math.min(model.maxTokens ?? contextWindow, contextWindow);
+		if (contextWindow === model.contextWindow && maxTokens === model.maxTokens) return model;
+		return { ...model, contextWindow, maxTokens };
+	});
+}
