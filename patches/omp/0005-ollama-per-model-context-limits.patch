+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { Agent } from "@oh-my-pi/pi-agent-core";
+import type { AssistantMessage, Context, FetchImpl, Model } from "@oh-my-pi/pi-ai";
+import { streamOllama } from "@oh-my-pi/pi-ai/providers/ollama";
+import { AssistantMessageEventStream } from "@oh-my-pi/pi-ai/utils/event-stream";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { AgentSession, type AgentSessionEvent } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { TempDir } from "@oh-my-pi/pi-utils";
+import { YAML } from "bun";
+import { beginSettingsTest, restoreSettingsTestState, type SettingsTestState } from "./helpers/settings-test-state";
+
+const ENDPOINT = "http://127.0.0.1:11434";
+const TRAINED_CONTEXT = 262_144;
+const GLOBAL_CAP = 131_072;
+
+/** An Ollama server with `names` installed, each trained on `trainedContext` tokens. */
+function mockOllama(names: string[], trainedContext = TRAINED_CONTEXT): FetchImpl {
+	return async input => {
+		const url = String(input);
+		if (url === `${ENDPOINT}/api/tags`) return Response.json({ models: names.map(name => ({ name })) });
+		if (url === `${ENDPOINT}/api/show`) {
+			return Response.json({
+				capabilities: ["completion", "tools"],
+				model_info: { "llama.context_length": trainedContext },
+			});
+		}
+		throw new Error(`Unexpected URL: ${url}`);
+	};
+}
+
+/** The `options` body an Ollama chat request for `model` carries. */
+async function requestOptions(model: Model): Promise<Record<string, unknown> | undefined> {
+	let options: Record<string, unknown> | undefined;
+	const fetchMock = async (_input: string | URL | Request, init?: RequestInit): Promise<Response> => {
+		options = (JSON.parse(String(init?.body)) as { options?: Record<string, unknown> }).options;
+		return new Response('{"message":{"content":"ok"},"done":true,"prompt_eval_count":1,"eval_count":1}\n');
+	};
+	const context: Context = { messages: [{ role: "user", content: "hi", timestamp: 0 }] };
+	await streamOllama(model as Model<"ollama-chat">, context, { apiKey: "test-key", fetch: fetchMock }).result();
+	return options;
+}
+
+describe("ollama.contextLimits", () => {
+	let state: SettingsTestState;
+	let tempDir: TempDir;
+	let modelsPath: string;
+	let authStorage: AuthStorage;
+
+	beforeEach(async () => {
+		state = beginSettingsTest();
+		for (const name of ["OLLAMA_BASE_URL", "OLLAMA_HOST", "OLLAMA_CONTEXT_LENGTH", "LLAMA_CPP_BASE_URL"]) {
+			delete Bun.env[name];
+		}
+		// The native api is the one that sends the window as `num_ctx`; the GUI
+		// sets this global cap for every model.
+		Bun.env.PI_OLLAMA_API = "ollama-chat";
+		Bun.env.OLLAMA_CONTEXT_LENGTH = String(GLOBAL_CAP);
+		tempDir = TempDir.createSync("@pi-ollama-context-limits-");
+		modelsPath = path.join(tempDir.path(), "models.json");
+		authStorage = await AuthStorage.create(":memory:");
+	});
+
+	afterEach(() => {
+		authStorage.close();
+		tempDir.removeSync();
+		restoreSettingsTestState(state);
+	});
+
+	async function discover(
+		limits: unknown,
+		options: { names?: string[]; trainedContext?: number } = {},
+	): Promise<ModelRegistry> {
+		const registry = new ModelRegistry(authStorage, modelsPath, {
+			fetch: mockOllama(options.names ?? ["m:latest", "other:latest"], options.trainedContext),
+			settings: Settings.isolated({ "ollama.contextLimits": limits }),
+		});
+		await registry.refresh();
+		return registry;
+	}
+
+	test("caps the listed model and sends the cap as num_ctx; other models keep the global cap", async () => {
+		const registry = await discover({ "m:latest": 32_768 });
+
+		const limited = registry.find("ollama", "m:latest");
+		expect(limited?.contextWindow).toBe(32_768);
+		expect(limited?.maxTokens).toBe(32_768);
+		expect((await requestOptions(limited!))?.num_ctx).toBe(32_768);
+		// No entry: the OLLAMA_CONTEXT_LENGTH cap still governs.
+		expect(registry.find("ollama", "other:latest")?.contextWindow).toBe(GLOBAL_CAP);
+	});
+
+	test("matches the id exactly, without :latest aliasing", async () => {
+		const registry = await discover({ m: 8192 });
+
+		expect(registry.find("ollama", "m:latest")?.contextWindow).toBe(GLOBAL_CAP);
+	});
+
+	test("a limit above the trained context leaves the trained context", async () => {
+		const registry = await discover({ "m:latest": 65_536 }, { trainedContext: 8192 });
+
+		expect(registry.find("ollama", "m:latest")?.contextWindow).toBe(8192);
+	});
+
+	/** Register `ids` under the `ollama` provider on the native api, as an extension would. */
+	function registerNativeOllama(registry: ModelRegistry, ids: string[]): void {
+		registry.registerProvider("ollama", {
+			baseUrl: ENDPOINT,
+			api: "ollama-chat",
+			apiKey: "ollama",
+			models: ids.map(id => ({
+				id,
+				name: id,
+				reasoning: false,
+				input: ["text" as const],
+				cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+				contextWindow: GLOBAL_CAP,
+				maxTokens: GLOBAL_CAP,
+			})),
+		});
+	}
+
+	test("caps a model of a provider registered as ollama on the native api", async () => {
+		// models.yml cannot select the native api, so another provider that speaks
+		// it under the `ollama` id comes from a runtime registration.
+		const registry = await discover({ "custom:7b": 32_768 });
+		registerNativeOllama(registry, ["custom:7b"]);
+
+		const model = registry.find("ollama", "custom:7b");
+		expect(model?.api).toBe("ollama-chat");
+		expect(model?.contextWindow).toBe(32_768);
+		expect((await requestOptions(model!))?.num_ctx).toBe(32_768);
+	});
+
+	test("caps a modelOverrides contextWindow above the limit", async () => {
+		const override = { contextWindow: 200_000, maxTokens: 200_000 };
+		fs.writeFileSync(
+			modelsPath,
+			JSON.stringify({ providers: { ollama: { modelOverrides: { "custom:7b": override, "plain:7b": override } } } }),
+		);
+		const registry = await discover({ "custom:7b": 32_768 });
+		registerNativeOllama(registry, ["custom:7b", "plain:7b"]);
+		await registry.refresh();
+
+		const model = registry.find("ollama", "custom:7b");
+		expect(model?.contextWindow).toBe(32_768);
+		expect(model?.maxTokens).toBe(32_768);
+		// The override itself applies to a model without a limit.
+		expect(registry.find("ollama", "plain:7b")?.contextWindow).toBe(200_000);
+	});
+
+	test("ignores malformed entries and keeps the valid ones", async () => {
+		const names = [
+			"str:latest",
+			"float:latest",
+			"neg:latest",
+			"zero:latest",
+			"huge:latest",
+			"obj:latest",
+			"ok:latest",
+		];
+		const registry = await discover(
+			{
+				"str:latest": "8192",
+				"float:latest": 8192.5,
+				"neg:latest": -8192,
+				"zero:latest": 0,
+				"huge:latest": 2 ** 30,
+				"obj:latest": { contextWindow: 8192 },
+				"ok:latest": 8192,
+			},
+			{ names },
+		);
+
+		const windows = Object.fromEntries(names.map(name => [name, registry.find("ollama", name)?.contextWindow]));
+		expect(windows).toEqual({
+			"str:latest": GLOBAL_CAP,
+			"float:latest": GLOBAL_CAP,
+			"neg:latest": GLOBAL_CAP,
+			"zero:latest": GLOBAL_CAP,
+			"huge:latest": GLOBAL_CAP,
+			"obj:latest": GLOBAL_CAP,
+			"ok:latest": 8192,
+		});
+	});
+
+	test("ignores a value that is not a record", async () => {
+		const overlayPath = path.join(tempDir.path(), "limits.yml");
+		await Bun.write(overlayPath, YAML.stringify({ ollama: { contextLimits: [32_768] } }));
+		const settings = await Settings.loadIsolated({
+			cwd: tempDir.path(),
+			agentDir: path.join(tempDir.path(), "agent"),
+			inMemory: true,
+			configFiles: [overlayPath],
+		});
+		const registry = new ModelRegistry(authStorage, modelsPath, { fetch: mockOllama(["m:latest"]), settings });
+		await registry.refresh();
+
+		expect(registry.find("ollama", "m:latest")?.contextWindow).toBe(GLOBAL_CAP);
+	});
+});
+
+describe("ollama.contextLimits live reload", () => {
+	let state: SettingsTestState;
+	let tempDir: TempDir;
+	let authStorage: AuthStorage;
+	let session: AgentSession | undefined;
+	let settings: Settings | undefined;
+
+	beforeEach(async () => {
+		state = beginSettingsTest();
+		for (const name of ["OLLAMA_BASE_URL", "OLLAMA_HOST", "OLLAMA_CONTEXT_LENGTH", "LLAMA_CPP_BASE_URL"]) {
+			delete Bun.env[name];
+		}
+		Bun.env.PI_OLLAMA_API = "ollama-chat";
+		Bun.env.OLLAMA_CONTEXT_LENGTH = "131072";
+		tempDir = TempDir.createSync("@pi-ollama-context-live-");
+		authStorage = await AuthStorage.create(":memory:");
+	});
+
+	afterEach(async () => {
+		await session?.dispose();
+		session = undefined;
+		settings?.stopWatching();
+		settings = undefined;
+		authStorage.close();
+		tempDir.removeSync();
+		restoreSettingsTestState(state);
+	});
+
+	async function waitFor(condition: () => boolean, timeoutMs = 5000): Promise<void> {
