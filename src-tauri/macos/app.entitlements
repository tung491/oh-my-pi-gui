<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PLIST 1.0.dtd">
<!-- The app itself needs only the microphone (voice dictation). The dyld,
     library-validation, JIT and unsigned-memory exemptions Electron needed do
     not apply to a WKWebView shell. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
