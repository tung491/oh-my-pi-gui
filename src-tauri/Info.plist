<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PLIST 1.0.dtd">
<!-- Merged into the bundle's Info.plist by the Tauri bundler. The camera and
     Bluetooth strings name the app and say it never uses them, so any prompt a
     user might see stays honest. ATS allows the loopback stats server and TLS
     only, so an accidental remote cleartext request cannot start working. -->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sai ATLAS uses the microphone for voice dictation in the composer.</string>
	<key>NSCameraUsageDescription</key>
	<string>Sai ATLAS does not use the camera.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Sai ATLAS does not use Bluetooth.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Sai ATLAS does not use Bluetooth.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
