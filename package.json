{
  "name": "@oh-my-pi/omp-gui",
  "version": "0.9.16",
  "private": true,
  "type": "module",
  "description": "Sai ATLAS, the private AI assistant for everyday work on SAI OS",
  "scripts": {
    "dev": "bun scripts/tauri-dev.ts",
    "dev:tauri": "bun scripts/tauri-dev.ts",
    "build": "vite build --config vite.tauri.config.ts && bun scripts/check-renderer-chunks.ts",
    "build:renderer:tauri": "vite build --config vite.tauri.config.ts",
    "build:tauri": "bash -c 'source scripts/rust-pins.env && PATH=\"$CARGO_HOME_BIN:$PATH\" cargo tauri build --no-bundle'",
    "package:tauri:linux": "bun run build:pack && bun scripts/stage-tauri-sidecar.ts x86_64-unknown-linux-gnu && bash -c 'source scripts/rust-pins.env && PATH=\"$CARGO_HOME_BIN:$PATH\" cargo tauri build --target x86_64-unknown-linux-gnu --config src-tauri/linux/sidecar.conf.json' && bun src-tauri/linux/finalize-deb.ts src-tauri/target/x86_64-unknown-linux-gnu/release/bundle/deb && bun src-tauri/linux/finalize-appimage.ts src-tauri/target/x86_64-unknown-linux-gnu/release/bundle/appimage",
    "package:tauri:mac:arm64": "bun scripts/stage-tauri-sidecar.ts aarch64-apple-darwin && bash -c 'source scripts/rust-pins.env && PATH=\"$CARGO_HOME_BIN:$PATH\" cargo tauri build --target aarch64-apple-darwin --config src-tauri/macos/sidecar.conf.json'",
    "package:tauri:mac:x64": "bun scripts/stage-tauri-sidecar.ts x86_64-apple-darwin && bash -c 'source scripts/rust-pins.env && PATH=\"$CARGO_HOME_BIN:$PATH\" cargo tauri build --target x86_64-apple-darwin --config src-tauri/macos/sidecar.conf.json'",
    "package:linux": "bash scripts/tauri-linux-build.sh",
    "gen:types": "bun scripts/gen-types.ts",
    "gen:icons": "bun scripts/gen-icons.ts",
    "gen:icons:tauri": "tauri icon resources/icon.png -o src-tauri/icons && rm -rf src-tauri/icons/android src-tauri/icons/ios",
    "build:pack": "bun scripts/build-assistant-pack.ts",
    "build:omp": "bun scripts/build-bundled-omp.ts",
    "build:omp:x64": "bun scripts/build-bundled-omp.ts --target bun-darwin-x64",
    "check": "node scripts/lint-surfaces.mjs && biome check . && tsc --noEmit",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.wdio.json",
    "check:protocol": "bun scripts/check-protocol.ts",
    "check:mac-update-floor": "bun scripts/check-mac-update-floor.ts",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:tauri": "wdio run wdio.conf.ts",
    "test:e2e:tauri:packaged": "wdio run wdio.packaged.conf.ts",
    "capture:showcase": "wdio run wdio.showcase.conf.ts",
    "bench": "vitest bench",
    "build:omp:linux": "bun scripts/build-bundled-omp.ts --target bun-linux-x64-baseline"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/view": "^6.36.0",
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.12.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chart.js": "^4.4.0",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "docx-preview": "0.4.1",
    "highlight.js": "^11.11.0",
    "katex": "^0.16.0",
    "lucide-react": "^0.500.0",
    "mermaid": "^11.0.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "6.0.0",
    "xlsx": "./vendor/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/bun": "1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "docx": "9.8.1",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "linkedom": "0.18.13",
    "marked": "18.0.14",
    "micromark-extension-math": "3.1.0",
    "micromark-util-types": "2.0.2",
    "pptxgenjs": "4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "unified": "11.0.5",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
