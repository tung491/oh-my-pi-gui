# Rust tool pins shared by every script that runs cargo (and by CI).
# rustup was installed with --no-modify-path, so the distro's /usr/bin/cargo shadows
# it on PATH: scripts put CARGO_HOME_BIN first and refuse to run without `cargo tauri`.
CARGO_HOME_BIN="$HOME/.cargo/bin"
# `cargo public-api` and the nightly it needs; the API snapshots were made with these.
CARGO_PUBLIC_API_VERSION=""
PUBLIC_API_TOOLCHAIN=""
